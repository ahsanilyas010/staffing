# ── Supabase ──────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# ── Anthropic (post-call scoring, CV parsing) ───────────────────────
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY

# ── Vapi.ai (AI voice screening) ────────────────────────────────────
VAPI_API_KEY=YOUR_VAPI_API_KEY
VAPI_PHONE_NUMBER_ID=YOUR_VAPI_PHONE_NUMBER_ID
VAPI_ASSISTANT_ID=YOUR_VAPI_ASSISTANT_ID
VAPI_WEBHOOK_SECRET=YOUR_VAPI_WEBHOOK_SECRET

# ── Twilio (PSTN + SMS + WhatsApp) ──────────────────────────────────
TWILIO_ACCOUNT_SID=YOUR_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN
TWILIO_SMS_FROM=YOUR_TWILIO_SMS_NUMBER
TWILIO_WHATSAPP_FROM=YOUR_TWILIO_WHATSAPP_NUMBER

# ── Email (Resend) ───────────────────────────────────────────────────
RESEND_API_KEY=YOUR_RESEND_API_KEY
EMAIL_FROM=hello@assorted.group

# ── Google Calendar (video interview Meet links) ────────────────────
GOOGLE_CALENDAR_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CALENDAR_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_CALENDAR_REFRESH_TOKEN=YOUR_GOOGLE_REFRESH_TOKEN

# ── Cron / background jobs ───────────────────────────────────────────
CRON_SECRET=YOUR_RANDOM_CRON_SECRET
VOICE_DAILY_BUDGET_USD=25
SCREENING_DAILY_CAP=60

# ── App ───────────────────────────────────────────────────────────────
APP_BASE_URL=https://staffing.assorted.group

# ── Embeddings (semantic bench search) ──────────────────────────────
EMBEDDINGS_API_KEY=YOUR_OPENAI_OR_COMPATIBLE_KEY
EMBEDDINGS_BASE_URL=https://api.openai.com/v1
EMBEDDINGS_MODEL=text-embedding-3-small
